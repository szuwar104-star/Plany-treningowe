{
  "name": "Plan → Garmin",
  "short_name": "Plan Garmin",
  "description": "Wysyła plan treningowy (plan.yaml) do repozytorium Plany-treningowe, skąd trafia do Garmin Connect.",
  "lang": "pl",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1F4E8C",
  "theme_color": "#1F4E8C",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./udostepnij",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{
        "name": "plik",
        "accept": ["text/*", ".yaml", ".yml", ".txt", "application/yaml", "application/x-yaml", "application/octet-stream"]
      }]
    }
  }
}
